---
import { postUrl, topicOf, type Post } from '../lib/posts';
import { swatchStyle } from '../lib/palette';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: Post[];
  /** Heading level for post titles — see the outline of the page using it. */
  headingLevel?: 2 | 3;
  /** Titles only. The homepage is meant to be read at a glance. */
  compact?: boolean;
  /** Hide the topic label, e.g. on a topic's own page where it is implied. */
  hideTopic?: boolean;
  emptyState?: string;
}

const { posts, headingLevel = 2, compact = false, hideTopic = false, emptyState } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{
  posts.length === 0 ? (
    <p class="note">{emptyState ?? 'Nothing here yet.'}</p>
  ) : (
    <ul class:list={['post-list', compact && 'is-compact']}>
      {posts.map((post) => {
        const topic = topicOf(post);
        return (
          <li>
            {/* Colour is the TOPIC's, so a row, its piece on the board and the
                post's own page all agree on what it is about. */}
            <a class="post-item" href={postUrl(post)} style={swatchStyle(topic.swatch)}>
              <p class="post-item-meta">
                <FormattedDate date={post.data.pubDate} />
                {!hideTopic && <span class="topic-tag">{topic.label}</span>}
                {post.data.draft && <span class="chip">Draft</span>}
              </p>
              <Heading class="post-item-title">{post.data.title}</Heading>
              {!compact && <p class="post-item-desc">{post.data.description}</p>}
            </a>
          </li>
        );
      })}
    </ul>
  )
}
