---
import { SITE, ZONES, ZONE_ORDER } from '../consts';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (path === href ? 'page' : undefined);
---

<header class="site-header">
  <div class="shell wide bar">
    <a class="brand" href="/">{SITE.title}</a>
    <nav class="site-nav" aria-label="Zones">
      {
        ZONE_ORDER.map((id) => (
          <a href={`/${id}/`} aria-current={isCurrent(`/${id}/`)}>
            {ZONES[id].label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
