---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Widen the main column (used by index and zone pages). */
  wide?: boolean;
}

const { wide = false, ...head } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <div class:list={['shell', wide && 'wide']}>
        <slot />
      </div>
    </main>
    <Footer />

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        btn.addEventListener('click', function () {
          // Resolve what is actually on screen before flipping it — with no
          // stored choice the theme comes from the OS, so toggling has to
          // read the computed state rather than assume light.
          var current =
            root.dataset.theme ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('thedzx:theme', next);
          } catch (e) {
            /* preference simply will not persist */
          }
        });
      })();
    </script>
  </body>
</html>
