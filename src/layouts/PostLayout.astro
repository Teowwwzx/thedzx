---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TopicChip from '../components/TopicChip.astro';
import { SITE } from '../consts';
import { swatchStyle } from '../lib/palette';
import { allPosts, postUrl, topicOf, type Post } from '../lib/posts';

interface Props { post: Post; }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft, placeholder } = post.data;
const topic = topicOf(post);

const url = new URL(`/blog/${post.id}/`, Astro.site).toString();

/*
 * Neighbouring pieces in the SAME topic — the puzzle's own sense of "next".
 * Older and newer, so a reader can walk a region either way.
 */
const inTopic = (await allPosts()).filter((p) => p.data.topic === post.data.topic);
const at = inTopic.findIndex((p) => p.id === post.id);
const newer = at > 0 ? inTopic[at - 1] : null;
const older = at >= 0 && at < inTopic.length - 1 ? inTopic[at + 1] : null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
    publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
    articleSection: topic.label,
    ...(tags.length ? { keywords: tags.join(', ') } : {}),
    inLanguage: SITE.locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.title, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: topic.label, item: new URL(`/topic/${topic.id}/`, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={`/og/blog/${post.id}.png`}
  jsonLd={placeholder ? [] : jsonLd}
  noindex={placeholder}
>
  <article class="prose" style={swatchStyle(topic.swatch)}>
    <hr class="article-band" aria-hidden="true" />

    <header style="margin-bottom:36px">
      <p class="post-item-meta" style="margin-bottom:12px">
        <FormattedDate date={pubDate} />
        {draft && <span class="chip ghost">Draft</span>}
      </p>
      <h1 style="font-size:clamp(29px,5.5vw,40px);margin-bottom:14px">{title}</h1>
      <p style="color:var(--ink-2);font-size:19px;margin:0 0 16px">{description}</p>
      <TopicChip topic={topic} />
      {
        updatedDate && (
          <p class="label" style="margin-top:14px">
            Updated <FormattedDate date={updatedDate} />
          </p>
        )
      }
    </header>

    <slot />

    <footer class="post-foot">
      {
        tags.length > 0 && (
          <p class="post-tags">
            {tags.map((t) => (
              <span class="chip swatch">{t}</span>
            ))}
          </p>
        )
      }
    </footer>
  </article>

  {/* The community layer. Hidden until the API answers — see community.ts. */}
  <section
    class="post-community community-only measure"
    data-community-post={post.id}
    style={swatchStyle(topic.swatch)}
    aria-labelledby="discuss-title"
    hidden
  >
    <div class="reactions" data-reactions aria-label="Reactions"></div>

    <h2 id="discuss-title" class="discuss-title">
      Thoughts <span class="discuss-count tabular" data-comment-count></span>
    </h2>
    <ul class="comments" data-comments></ul>

    <form class="comment-form" data-comment-form novalidate>
      <label class="sr-only" for="c-name">Name</label>
      <input id="c-name" name="name" required maxlength="30" autocomplete="nickname" placeholder="Your name" />
      <label class="sr-only" for="c-text">Your thoughts</label>
      <textarea id="c-text" name="text" required maxlength="1000" rows="3" placeholder="What did you think? Questions welcome."></textarea>
      <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="comment-row">
        <button type="submit">Post</button>
        <p class="comment-status" data-comment-status role="status"></p>
      </div>
    </form>
  </section>

  <nav class="piece-nav measure" aria-label={`More in ${topic.label}`} style={swatchStyle(topic.swatch)}>
    {
      older && (
        <a class="piece-nav-link" href={postUrl(older)}>
          <span class="pn-dir">← Earlier piece</span>
          <span class="pn-title">{older.data.title}</span>
        </a>
      )
    }
    {
      newer && (
        <a class="piece-nav-link is-next" href={postUrl(newer)}>
          <span class="pn-dir">Next piece →</span>
          <span class="pn-title">{newer.data.title}</span>
        </a>
      )
    }
    <a class="piece-nav-home" href="/">Back to the puzzle</a>
  </nav>
</BaseLayout>

<script>
  import { initCommunityPost } from '../scripts/community';
  initCommunityPost();
</script>
