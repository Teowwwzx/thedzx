---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';
import { swatchFor } from '../lib/palette';
import type { Post } from '../lib/posts';

interface Props { post: Post; }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft, placeholder } = post.data;

const url = new URL(`/blog/${post.id}/`, Astro.site).toString();

// The same hue this post has on the index, and on its OG card. Derived from
// the slug in one place — see src/lib/palette.ts.
const swatch = swatchFor(post.id);

// BlogPosting + BreadcrumbList. The breadcrumb encodes the real spatial
// hierarchy — site → zone → post — which is also how the 3D world navigates.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
    publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
    ...(tags.length ? { keywords: tags.join(', ') } : {}),
    inLanguage: SITE.locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.title, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={`/og/blog/${post.id}.png`}
  jsonLd={placeholder ? [] : jsonLd}
  noindex={placeholder}
>
  <article
    class="prose"
    style={`--sw: var(--sw-${swatch.name}); --bold: var(--bold-${swatch.name})`}
  >
    {/* Decorative: the post's colour, stated once, at full width. */}
    <hr class="article-band" aria-hidden="true" />

    <header style="margin-bottom:36px">
      <p class="post-item-meta" style="margin-bottom:12px">
        <FormattedDate date={pubDate} />
        {draft && <span class="chip ghost">Draft</span>}
      </p>
      <h1 style="font-size:clamp(29px,5.5vw,40px);margin-bottom:14px">{title}</h1>
      <p style="color:var(--ink-2);font-size:19px;margin:0">{description}</p>
      {
        updatedDate && (
          <p class="label" style="margin-top:14px">
            Updated <FormattedDate date={updatedDate} />
          </p>
        )
      }
    </header>

    <slot />

    <footer style="margin-top:56px;padding-top:24px;border-top:1px solid var(--line)">

      {
        tags.length > 0 && (
          <p style="display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px">
            {tags.map((t) => (
              <span class="chip swatch">{t}</span>
            ))}
          </p>
        )
      }
      <p style="margin:0">
        <a href="/">All posts</a>
      </p>
    </footer>
  </article>
</BaseLayout>
