---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';
import { allPosts } from '../lib/posts';

/**
 * The blog.
 *
 * Type does the structural work — one big gesture, a lot of air — and
 * colour does the rest: a field behind the masthead, a band of floating
 * objects under it, and a swatch per post that follows it to its own page.
 *
 * The 3D world (a walkable room, a street, a tower) is ON HOLD, not
 * deleted. See LOCATIONS.md. The objects in the hero are new and separate:
 * decoration, no navigation, nothing to enter.
 */
const posts = await allPosts();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.locale,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd} wide>
  {/*
    Runs BEFORE the hero below is parsed, which is the whole point: it
    reserves the object band in the very first layout, so the canvas
    arriving 300ms later pushes nothing down. The check is a cheap proxy
    for "this browser can do WebGL" — an actual context probe here would
    cost a canvas and a GPU handle before first paint. If the real context
    then fails, the module script below takes the class off again.
  */}
  <script is:inline>
    if (window.WebGL2RenderingContext) document.documentElement.classList.add('stage-ok');
  </script>

  <section class="hero">
    <div class="masthead">
      <p class="tagline-chip">{SITE.tagline}</p>
      <h1>{SITE.title}</h1>
      <p class="masthead-lede">{SITE.description}</p>
    </div>

    {/* Decoration. No text, no links, nothing to read — so it is hidden
        from assistive technology rather than described. */}
    <div class="hero-stage" id="hero-stage" aria-hidden="true"></div>
  </section>

  <section class="reveal">
    <p class="count-chip">
      <span class="dot" style="--bold: var(--bold-mint)"></span>
      {posts.length === 0 ? 'Writing' : `Writing — ${posts.length}`}
    </p>
    <PostList posts={posts} headingLevel={2} />
  </section>
</BaseLayout>

<script>
  /*
   * The only external script on the site, and it is on this page only.
   *
   * Deferred to idle so it never competes with the fonts or the first
   * paint, and dynamically imported so three.js lands in a chunk of its
   * own that no other route pulls in.
   */
  const host = document.getElementById('hero-stage');

  if (host) {
    const collapse = () => document.documentElement.classList.remove('stage-ok');

    const go = () => {
      import('../scenery/hero')
        .then((m) => {
          if (!m.mount(host)) collapse();
        })
        .catch(collapse);
    };

    if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 2500 });
    else setTimeout(go, 300);
  }
</script>
