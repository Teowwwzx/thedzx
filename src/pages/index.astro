---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Puzzle from '../components/Puzzle.astro';
import TopicChip from '../components/TopicChip.astro';
import AskBox from '../components/AskBox.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE, TOPIC_LIST } from '../consts';
import { swatchStyle } from '../lib/palette';
import { allPosts, postUrl, postsByTopic, topicOf } from '../lib/posts';

/**
 * The homepage is the puzzle.
 *
 * One region per topic, one piece per post; empty pieces are what has not
 * been written yet, and readers can ask for one. Words are kept to a minimum
 * on purpose — the board is the table of contents.
 *
 * Everything works without JavaScript: pieces are links, the list below is the
 * same posts as text. The script adds the preview panel, the region highlight
 * and the community layer (asked-for pieces, the ask form) on top.
 *
 * The floating desk objects that used to live here are PARKED in
 * src/scenery/, the same way the 3D world is parked in src/world/.
 */
const posts = await allPosts();
const byTopic = await postsByTopic();
const latest = posts[0];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.locale,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd} wide>
  <section class="home-hero">
    <div class="hh-intro">
      <p class="tagline-chip">{SITE.tagline}</p>
      <h1 class="hh-title">{SITE.title}</h1>
      <p class="hh-lede">{SITE.description}</p>
    </div>

    <div class="hh-board">
      <Puzzle posts={posts} />
    </div>

    <div class="hh-side">
      {/* What the pointer is on. Starts on the newest piece, so it is never
          empty, and it is a real link without JavaScript. */}
      <aside class="piece-panel" data-panel aria-live="polite">
        {
          latest ? (
            <div style={swatchStyle(topicOf(latest).swatch)}>
              <p class="pp-kicker">
                <span class="dot" /> Latest · <FormattedDate date={latest.data.pubDate} />
              </p>
              <a class="pp-title" href={postUrl(latest)}>
                {latest.data.title}
              </a>
              <p class="pp-topic">
                {topicOf(latest).label} · <span lang="zh">{topicOf(latest).zh}</span>
              </p>
            </div>
          ) : (
            <p class="pp-kicker">The first piece is on its way.</p>
          )
        }
      </aside>

      <ul class="legend" aria-label="Topics">
        {
          TOPIC_LIST.map((t) => (
            <li>
              <TopicChip topic={t} count={byTopic[t.id].length} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="home-latest reveal" aria-labelledby="latest-title">
    <h2 id="latest-title" class="section-chip">All pieces</h2>
    <PostList posts={posts} headingLevel={3} compact />
  </section>

  {/* Filled in by the community script; stays hidden if the API is down. */}
  <section class="asked community-only" aria-labelledby="asked-title" hidden>
    <h2 id="asked-title" class="section-chip">Asked by readers</h2>
    <ul class="asked-list" data-asked-list></ul>
  </section>

  <AskBox />
</BaseLayout>

<script>
  import { initBoard } from '../scripts/board';
  import { initCommunityHome } from '../scripts/community';

  initBoard();
  initCommunityHome();
</script>
