---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';
import { allPosts } from '../lib/posts';

/**
 * The blog.
 *
 * One big gesture and a lot of air. No topic taxonomy, no hero image, no
 * cards — the reference sites this is modelled on (aardvarkbookclub.com,
 * sharplink.com) get their presence almost entirely from type size,
 * negative tracking and whitespace, not from decoration.
 *
 * The 3D world is ON HOLD, not deleted. See LOCATIONS.md.
 */
const posts = await allPosts();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.locale,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd} wide>
  <section class="masthead">
    <p class="label">{SITE.tagline}</p>
    <h1>{SITE.title}</h1>
    <p class="masthead-lede">{SITE.description}</p>
  </section>

  <hr class="rule rule-draw" style="margin-top:clamp(64px,14vh,140px)" />

  <section class="reveal" style="margin-top:34px">
    <p class="label" style="margin:0 0 6px">
      {posts.length === 0 ? 'Writing' : `Writing — ${posts.length}`}
    </p>
    <PostList posts={posts} headingLevel={2} />
  </section>
</BaseLayout>
