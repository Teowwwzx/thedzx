---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE, ZONES, ZONE_ORDER } from '../consts';
import { allPosts } from '../lib/posts';

/**
 * The blog.
 *
 * The 3D world is ON HOLD, not deleted — everything for it is still in
 * `src/world/` and `src/world/locations/`. Nothing on the site loads it, so
 * it costs no bytes and ships no JavaScript. See LOCATIONS.md for how to put
 * it back.
 *
 * This page is deliberately near-empty. There is nothing published yet, and
 * inventing filler to make it look busy would be worse than an honest blank.
 */
const posts = await allPosts();
const counts = Object.fromEntries(
  ZONE_ORDER.map((id) => [id, posts.filter((p) => p.data.zone === id).length]),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.locale,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd} wide>
  <section class="masthead">
    <p class="label">{SITE.tagline}</p>
    <h1>{SITE.title}</h1>
    <p class="masthead-lede">{SITE.description}</p>
  </section>

  <section style="margin-top:56px">
    <h2 class="label" style="margin-bottom:8px">Writing</h2>
    <PostList posts={posts} />
  </section>

  <section style="margin-top:56px">
    <h2 class="label" style="margin-bottom:16px">Topics</h2>
    <ul class="topic-list">
      {
        ZONE_ORDER.map((id) => {
          const n = counts[id] ?? 0;
          return (
            <li>
              <a href={`/${id}/`}>
                <span class="topic-name">{ZONES[id].label}</span>
                <span class="topic-count tabular">{n}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
