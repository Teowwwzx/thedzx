---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE, ZONES, ZONE_ORDER } from '../consts';
import { allPosts } from '../lib/posts';

const posts = await allPosts();
const counts = Object.fromEntries(
  ZONE_ORDER.map((id) => [id, posts.filter((p) => p.data.zone === id).length]),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.locale,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd} wide>
  <section style="padding-block: 32px 8px; max-width: 62ch;">
    <p class="label" style="margin:0 0 16px">{SITE.tagline}</p>
    <h1 style="font-size:clamp(32px,6vw,48px);margin-bottom:18px">
      Notes from inside the machine.
    </h1>
    <p style="color:var(--ink-2);font-size:19px;margin:0 0 26px">
      {SITE.description}
    </p>
    <p style="margin:0">
      <a class="chip" href="/world/">Walk into the room →</a>
    </p>
  </section>

  <section style="margin-top:56px">
    <h2 class="label" style="margin-bottom:16px">The map</h2>
    <ul class="zone-grid">
      {
        ZONE_ORDER.map((id) => {
          const z = ZONES[id];
          const n = counts[id] ?? 0;
          return (
            <li>
              <a class="zone-card" href={`/${id}/`}>
                <span class="rail">
                  <span class="elev">{z.elevation}</span>
                  <span>Stage {z.stage}</span>
                </span>
                <h3>{z.label}</h3>
                <p>{z.blurb}</p>
                <span class="count tabular">
                  {n === 0 ? 'No posts yet' : n === 1 ? '1 post' : `${n} posts`}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section style="margin-top:64px">
    <h2 class="label" style="margin-bottom:8px">Everything, newest first</h2>
    <PostList posts={posts} headingLevel={3} />
  </section>
</BaseLayout>
