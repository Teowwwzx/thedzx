---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { SITE, ZONES, ZONE_ORDER, type ZoneId } from '../../consts';
import { allPosts } from '../../lib/posts';

// Only the six known zones are ever emitted — no catch-all at the root.
export const getStaticPaths = (() =>
  ZONE_ORDER.map((zone) => ({ params: { zone } }))) satisfies GetStaticPaths;

const zone = Astro.params.zone as ZoneId;
const z = ZONES[zone];
const posts = (await allPosts()).filter((p) => p.data.zone === zone);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: z.label,
    description: z.blurb,
    url: new URL(`/${zone}/`, Astro.site).toString(),
    isPartOf: { '@type': 'WebSite', name: SITE.title, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.title, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: z.label, item: new URL(`/${zone}/`, Astro.site).toString() },
    ],
  },
];
---

<BaseLayout title={z.label} description={z.blurb} image={`/og/zone/${zone}.png`} jsonLd={jsonLd} wide>
  <section style="padding-block:32px 8px;max-width:62ch">
    <p class="label" style="margin:0 0 14px">
      Elevation {z.elevation} · Built in stage {z.stage}
    </p>
    <h1 style="font-size:clamp(30px,5.5vw,42px);margin-bottom:16px">{z.label}</h1>
    <p style="color:var(--ink-2);font-size:19px;margin:0 0 20px">{z.blurb}</p>
    <p class="label" style="margin:0 0 22px">
      Props here: {z.props.join(' · ')}
    </p>

    {
      /* The TV is live data rather than a place you stand, so it is the one
         zone with no walkable counterpart. A dead link is worse than none. */
      zone !== 'tv' && (
        <p style="margin:0">
          <a class="chip" href="/">Walk in →</a>
        </p>
      )
    }
  </section>

  <section style="margin-top:44px">
    <PostList posts={posts} showZone={false} emptyState={z.emptyState} />
  </section>
</BaseLayout>
