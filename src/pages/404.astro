---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page does not exist on this site." noindex>
  <div class="prose" style="padding-block:48px">
    <p class="label">404</p>
    <h1 style="font-size:clamp(28px,5vw,38px);margin-block:12px 16px">
      This piece doesn't exist.
    </h1>
    <p>
      Maybe it moved, maybe it was never written. <a href="/">Back to the puzzle</a>.
    </p>
  </div>
</BaseLayout>
