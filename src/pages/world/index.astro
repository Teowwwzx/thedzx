---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ZONES, type ZoneId } from '../../consts';
import { allPosts, postUrl } from '../../lib/posts';

/**
 * The 3D room.
 *
 * A normal, fully server-rendered page. The world is not loaded until the
 * visitor clicks Enter — so the canvas can never be the LCP element
 * (AGENTS.md rule 3), and everything the room contains is reachable as real
 * markup below whether or not any JavaScript runs (rule 2).
 *
 * Title and H1 are deliberately NOT "The Room": /room/ already owns that
 * exact title, h1 and OG card. Two self-canonical URLs in the same sitemap
 * competing for one query is a duplicate-content problem, and the more useful
 * page — the readable one — should win it.
 */
const posts = await allPosts();
const WALKABLE = ['room', 'city', 'gym', 'tower', 'server'] as const;

const description =
  'Walk the whole world in 3D: a room with a desk, the street outside, a gym, the top of Merdeka 118, and the server room under it all.';
---

<BaseLayout title="Walk the world" description={description} image="/og/zone/room.png" wide>
  <section class="world-intro">
    <p class="label">Five locations · Greybox · WebGL</p>
    <h1>Walk the world</h1>
    <p class="world-lede">{description}</p>

    <!--
      Disabled by default and enabled by the script below. Otherwise the
      primary call to action renders live and clickable with JS off and does
      nothing at all when pressed.
    -->
    <button type="button" id="world-enter" class="world-enter" data-ready="no" disabled>
      <span class="world-enter-main">Enter the room</span>
      <span class="world-enter-sub">WebGL · loads on click, not on page load</span>
    </button>

    <p id="world-gate-msg" class="note" hidden></p>

    <noscript>
      <p class="note">
        The room needs JavaScript and WebGL. Everything in it is listed below,
        which is rather the point — the world is a second way in, never the
        only one.
      </p>
    </noscript>
  </section>

  <!-- Mount point. Stays empty and hidden until Enter is clicked. -->
  <div id="world-root" class="world-root" hidden></div>

  <!--
    The HUD, as real markup. Every hotspot in the 3D room has a matching
    <a href> here. Raycast clicks generate zero crawlable links, so this
    section is what Google and a screen reader actually see. Do not delete it.
  -->
  <section class="world-index">
    <h2 class="label">Everywhere you can walk</h2>
    <ul class="world-index-list">
      {
        WALKABLE.map((id) => {
          const z = ZONES[id as ZoneId];
          const n = posts.filter((p) => p.data.zone === id).length;
          return (
            <li>
              <strong>{z.label}</strong> — {z.blurb}{' '}
              <a href={`/${id}/`}>
                {n === 0 ? `Nothing published in ${z.label} yet` : n === 1 ? '1 post' : `${n} posts`}
              </a>
            </li>
          );
        })
      }
      <li>
        <strong>The TV</strong> — markets rather than posts. Delayed quotes,
        charts by TradingView. <a href="/tv/">About the TV</a>.
      </li>
    </ul>

    {
      posts.length > 0 ? (
        <ul class="post-list" style="margin-top:28px">
          {posts.map((post) => (
            <li>
              <a class="post-item" href={postUrl(post)}>
                <p class="post-item-meta">
                  <span class="chip ghost">{ZONES[post.data.zone as ZoneId].label}</span>
                  <span class="chip ghost">{post.data.prop}</span>
                </p>
                <h3 class="post-item-title">{post.data.title}</h3>
                <p class="post-item-desc">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="note" style="margin-top:28px">
          Nothing published anywhere yet, so every surface in there is empty
          too. <a href="/">The map</a> is where posts appear first.
        </p>
      )
    }
  </section>
</BaseLayout>

<script>
  // Click-to-load. Nothing from the world bundle — React, three.js, R3F,
  // drei — is fetched until this handler runs, so the page's own JS footprint
  // is this listener and nothing more.
  const btn = document.getElementById('world-enter') as HTMLButtonElement | null;
  const root = document.getElementById('world-root');
  const msg = document.getElementById('world-gate-msg');
  const main = btn?.querySelector('.world-enter-main');

  /**
   * Cheap capability check, run BEFORE the download.
   *
   * The full device gate lives inside the world bundle, which meant a device
   * it rejected had already paid for ~1.09 MB of JavaScript to be told no.
   * Anything we can decide from a 2 KB script belongs here instead.
   */
  function blocker(): string | null {
    let gl: WebGL2RenderingContext | null = null;
    try {
      gl = document.createElement('canvas').getContext('webgl2');
    } catch {
      gl = null;
    }
    if (!gl) return 'This browser has no WebGL2, so the room cannot run here.';
    // Free the probe context straight away; browsers cap how many exist.
    gl.getExtension('WEBGL_lose_context')?.loseContext();

    // Chromium-only, and undefined on iOS and in Firefox — so its ABSENCE
    // must never be read as "fine". Only a positive true blocks.
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData === true) {
      return 'Your browser is in data-saver mode, so the room has not been loaded.';
    }
    return null;
  }

  if (btn && root) {
    const reason = blocker();
    if (reason) {
      if (msg) {
        msg.textContent = `${reason} Everything in the room is listed below.`;
        msg.hidden = false;
      }
      btn.hidden = true;
    } else {
      btn.disabled = false;
      btn.dataset.ready = 'yes';
    }

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      if (main) main.textContent = 'Loading the room…';

      try {
        const { mount } = await import('../../world/mount');
        root.hidden = false;
        await mount(root);
        btn.hidden = true;
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        console.error('[world] failed to load', err);
        btn.disabled = false;
        if (main) main.textContent = 'Enter the room';
        root.hidden = true;
        if (msg) {
          msg.textContent =
            'The room failed to load. Everything in it is listed below, so nothing is lost.';
          msg.hidden = false;
        }
      }
    });
  }
</script>
